---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": "{{ post.title | escape }}",
    "url": "{{ post.url }}",
    "date": "{{ post.date | date: '%Y-%m-%d' }}",
    "excerpt": "{{ post.excerpt | strip_newlines | escape }}",
    "image": "{{ post.image | default: post.featured_image }}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
